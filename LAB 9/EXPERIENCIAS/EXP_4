# ==========================================
# EXPERIENCIA 4: ESTADO Y CONSUMO DE API
# ==========================================
class EstadoUsuarios(rx.State):
    usuarios: list[dict[str, str]] = []
    cargando: bool = False
    error: str = ""

    @rx.event
    async def cargar_usuarios(self):
        self.cargando = True
        self.error = ""
        self.usuarios = []

        try:
            async with httpx.AsyncClient() as cliente:
                respuesta = await cliente.get(
                    "https://jsonplaceholder.typicode.com/users",
                    timeout=5.0
                )
                respuesta.raise_for_status()
                datos = respuesta.json()

                usuarios_procesados = []
                for item in datos:
                    usuarios_procesados.append({
                        "name": item.get("name", ""),
                        "username": item.get("username", ""),
                        "email": item.get("email", ""),
                        "company": item.get("company", {}).get("name", "N/A"),
                    })

                self.usuarios = usuarios_procesados

        except httpx.HTTPError as e:
            self.error = f"Error de conexión con la API: {str(e)}"
        except Exception as e:
            self.error = f"Ocurrió un error inesperado: {str(e)}"
        finally:
            self.cargando = False

